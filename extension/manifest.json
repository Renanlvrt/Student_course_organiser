{
  "manifest_version": 3,
  "name": "Alt+O Blackboard Helper",
  "version": "1.2.0",
  "description": "Tags Blackboard downloads with course + section for the Alt+O organiser, and downloads new files in a section.",
  "permissions": [
    "downloads",
    "storage",
    "tabs",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://*.durham.ac.uk/*",
    "https://*.blackboard.com/*",
    "http://127.0.0.1:47821/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.durham.ac.uk/*",
        "https://*.blackboard.com/*"
      ],
      "js": [
        "bbparse.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Alt+O Blackboard Helper",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "key": ""
}